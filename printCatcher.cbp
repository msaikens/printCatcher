				<Option compiler="gfortran" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
		</Compiler>
		<Linker>
			<Add library="usb-1.0" />
			<Add library="dpfpdd" />
			<Add directory="lib" />
		</Linker>
		<Unit filename="fp4500_device.f90">
			<Option target="Debug" />
